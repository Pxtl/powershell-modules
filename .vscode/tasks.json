{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dotnet build debug",
            "type": "shell",
            "command": "Get-ChildItem *.sln -Recurse | ForEach-Object { dotnet build $_.FullName -c debug }",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
        },
        {
            "label": "dotnet build release",
            "type": "shell",
            "command": "Get-ChildItem *.sln -Recurse | ForEach-Object { dotnet build $_.FullName -c release }",
            "group": {
                "kind": "build"
            },
            "problemMatcher": [],
        },
        {
            "label": "dotnet clean",
            "type": "shell",
            "command": "Get-ChildItem *.sln -Recurse | ForEach-Object { dotnet clean $_.FullName -c debug; dotnet clean $_.FullName -c release; }",
            "group": {
                "kind": "build"
            },
            "problemMatcher": [],
        }
    ]
}